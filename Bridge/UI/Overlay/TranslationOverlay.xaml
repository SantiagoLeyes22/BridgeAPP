<Window
    x:Class="Bridge.UI.Overlay.TranslationOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Bridge">

    <Grid x:Name="RootGrid" Padding="18" RowSpacing="12" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE774;" FontSize="18" VerticalAlignment="Center" />
            <TextBlock
                x:Name="DirectionText"
                Grid.Column="1"
                FontWeight="SemiBold"
                Text="Translating"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="ProviderText"
                Grid.Column="2"
                Text="Engine"
                Opacity="0.65"
                VerticalAlignment="Center" />
            <StackPanel
                x:Name="ResultOptionsPanel"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <ComboBox
                    x:Name="ResultStyleComboBox"
                    Width="116"
                    Padding="8,2"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="ResultOption_SelectionChanged"
                    ToolTipService.ToolTip="Translation style" />
                <ComboBox
                    x:Name="ResultTargetLanguageComboBox"
                    Width="106"
                    Padding="8,2"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="ResultOption_SelectionChanged"
                    ToolTipService.ToolTip="Target language" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel x:Name="LoadingPanel" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="28" Height="28" />
                <TextBlock Text="Translating…" Opacity="0.75" />
            </StackPanel>

            <ScrollViewer x:Name="ResultPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="TranslatedText"
                    TextWrapping="WrapWholeWords"
                    IsTextSelectionEnabled="True"
                    FontSize="16" />
            </ScrollViewer>

            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="ErrorTitle" Text="Translation unavailable" FontWeight="SemiBold" />
                <TextBlock x:Name="ErrorMessage" TextWrapping="WrapWholeWords" Opacity="0.8" />
            </StackPanel>

        </Grid>

        <StackPanel x:Name="ResultButtons" Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Visibility="Collapsed">
            <Button Content="Copy" Click="Copy_Click" />
            <Button x:Name="ReplaceButton" Content="Replace" Click="Replace_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="Close" Click="Close_Click" />
        </StackPanel>

        <Button x:Name="ErrorCloseButton" Grid.Row="2" Content="Close" Click="Close_Click" HorizontalAlignment="Right" Visibility="Collapsed" />
    </Grid>
</Window>
